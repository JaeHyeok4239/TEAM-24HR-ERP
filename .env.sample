# =========================
# 24HR ERP Environment Sample
# =========================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Oracle DB
DB_URL=jdbc:oracle:thin:@192.168.0.50:1522/XEPDB1
DB_USERNAME=hr24
DB_PASSWORD=hr24

# Redis
REDIS_HOST=192.168.0.50
REDIS_PORT=6379

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLED=false
MAIL_FROM=no-reply@24hr.local

# JWT
JWT_SECRET=change-this-to-long-random-secret-key-for-production
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Sensitive Data Encryption
HR24_CRYPTO_SECRET_KEY=change-this-to-base64-encoded-32-byte-key

# JPA
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Spring Doc
SPRINGDOC_ENABLED=false

# File Upload
FILE_UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=500MB

# Holiday API
HOLIDAY_API_KEY=