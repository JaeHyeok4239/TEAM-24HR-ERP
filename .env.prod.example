# =========================
# 24HR ERP Production Docker Env Example
# =========================

# Ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
ORACLE_HOST_PORT=1522
REDIS_HOST_PORT=6379

# Oracle
ORACLE_PASSWORD=change-oracle-admin-password
DB_USERNAME=hr24
DB_PASSWORD=change-hr24-db-password

# Redis
# 내부에서는 redis:6379 사용

# Mail
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Security
JWT_SECRET=change-this-to-long-random-secret-key
HR24_CRYPTO_SECRET_KEY=change-this-to-base64-encoded-32-byte-key

# CORS / Cookie
# 첫 배포 테스트는 HTTP 기준
CORS_ALLOWED_ORIGINS=http://서버IP:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Upload
UPLOAD_HOST_PATH=/var/www/hr24/uploads

# Swagger
SPRINGDOC_ENABLED=true

# Frontend
# 첫 배포 테스트는 backend 직접 호출
NEXT_PUBLIC_API_ORIGIN=http://서버IP:8080