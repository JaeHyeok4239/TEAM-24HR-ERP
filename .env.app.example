# =========================
# 24HR ERP App Docker Env Example
# =========================

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:oracle:thin:@서버IP:1522/XEPDB1
DB_USERNAME=hr24
DB_PASSWORD=change-me

REDIS_HOST=서버IP
REDIS_PORT=6379

MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

JWT_SECRET=change-this-to-long-random-secret
HR24_CRYPTO_SECRET_KEY=change-this-to-base64-encoded-32-byte-key

CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

FILE_UPLOAD_PATH=/app/uploads
SPRINGDOC_ENABLED=true

HOLIDAY_API_KEY=change-this-to-holiday-api-key

NEXT_PUBLIC_API_ORIGIN=http://localhost:8080